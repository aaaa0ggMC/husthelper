{
  "name": "husthelper",
  "version": "1.0.0",
  "description": "HUST 统一身份认证 + 一卡通流水查询的 Node.js 封装",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./hustnet": "./hustnet.ts"
  },
  "bin": {
    "hustnet": "./examples/net_cli.ts"
  },
  "scripts": {
    "start": "node examples/get_costs.ts",
    "net": "node examples/net_cli.ts",
    "example:profile": "node examples/get_profile.ts",
    "example:grades": "node examples/get_grades.ts",
    "example:exams": "node examples/get_exams.ts",
    "example:free-rooms": "node examples/get_free_rooms.ts",
    "example:registration": "node examples/get_registration.ts",
    "example:credit-summary": "node examples/get_credit_summary.ts",
    "example:online-devices": "node examples/get_online_devices.ts",
    "example:service-center": "node examples/get_service_center.ts",
    "example:exercise": "node examples/get_exercise_engagements.ts",
    "example:reserves": "node examples/get_reserves.ts",
    "example:fitness": "node examples/get_fitness.ts",
    "example:custom-ocr": "node examples/custom_ocr.ts",
    "example:export_ledger": "node --experimental-strip-types examples/export_ledger.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "hust",
    "cas",
    "ecard"
  ],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "axios": "^1.20.0",
    "gifuct-js": "^2.1.2",
    "jpeg-js": "^0.4.4"
  }
}
